# Copy sang .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# Soniox STT/translation (temp key server-side cấp cho client — xem docs/soniox-integration-notes.md)
SONIOX_API_KEY=

# Anthropic Claude (CV parse, question gen, report gen)
ANTHROPIC_API_KEY=

# Supabase project (region ap-northeast-1 — Tokyo)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Tuỳ chọn — email admin, phân cách dấu phẩy. Để trống thì /admin trả 404 với mọi người.
ADMIN_EMAILS=
